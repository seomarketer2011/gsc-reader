{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsc-reader",
  // Seomarketer2011@yahoo.co.uk's Cloudflare account (account IDs are not secret).
  "account_id": "44799b719f2192a9f066f425aaff3106",
  "main": "worker-entry.mjs",
  "triggers": {
    // 03:30 UTC: nightly GSC top-up + re-analysis.
    // Every 5 min 02:00-05:55 UTC: rank-tracker refresh, one batch per tick.
    "crons": ["30 3 * * *", "*/5 2-5 * * *"]
  },
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Environment variables (NEXT_PUBLIC_SUPABASE_URL, keys, …) are NOT set
  // here — add them as Variables & Secrets on the Worker in the Cloudflare
  // dashboard so they never enter the repository.
}
