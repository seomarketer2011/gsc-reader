{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsc-reader",
  // Seomarketer2011@yahoo.co.uk's Cloudflare account (account IDs are not secret).
  "account_id": "44799b719f2192a9f066f425aaff3106",
  "main": "worker-entry.mjs",
  "triggers": {
    // Nothing is refreshed automatically — GSC imports, analysis and rank
    // checks all run from their buttons in the app, when you ask for them.
    //
    // The one remaining tick collects finished DataForSEO tasks every 5
    // minutes. It never starts a check and never spends anything: it only
    // banks results a check you started has already paid for, so closing
    // the tab mid-run can't lose them.
    "crons": ["*/5 * * * *"]
  },
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Environment variables (NEXT_PUBLIC_SUPABASE_URL, keys, …) are NOT set
  // here — add them as Variables & Secrets on the Worker in the Cloudflare
  // dashboard so they never enter the repository.
}
